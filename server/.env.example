# Server Configuration (Port 5050 avoided default macOS AirPlay conflict on 5000)
PORT=5050
NODE_ENV=development

# MongoDB Connection String (leave blank or specify mongodb://localhost:27017/lifelink)
# If local mongod is not reachable, LifeLink will automatically launch an in-memory database in development mode
MONGODB_URI=

# JWT Secret for secure tokens
JWT_SECRET=lifelink_super_secret_jwt_key_college_project_2026_dev
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Notification Provider (options: simulated, in-app)
NOTIFICATION_PROVIDER=simulated
